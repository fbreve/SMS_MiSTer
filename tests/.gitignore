# original hashes, scripts and consolidated conclusions are versioned separately.
/_artifacts/gzip/
**/obj_dir/
**/native_obj/
**/__pycache__/
/uv_cache/
# Override broad repository extension exclusions for scientific metadata.
!**/*.csv
!**/*.summary
!**/*.xml
!**/*.f
