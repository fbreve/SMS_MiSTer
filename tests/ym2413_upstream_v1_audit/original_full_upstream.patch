+ .fm_state_addr(fm_addr),.fm_state_read(fm_read),.fm_state_write(fm_write),.fm_state_wdata(fm_wdata),.fm_state_rdata(fm_rdata),.fm_initialized(1'b1),.fm_initialization_run(fm_init_run),.fm_legacy_reset(fm_reset));
+always #5 clk=~clk;
