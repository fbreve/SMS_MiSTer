diff --git a/tests/ym2413_fullstate/campaign.ps1 b/tests/ym2413_fullstate/campaign.ps1
new file mode 100644
index 00000000..4bbb074f
--- /dev/null
+++ b/tests/ym2413_fullstate/campaign.ps1
@@ -0,0 +1,15 @@
+param([int[]]$Modes=@(1,2,3,4,5,6))
+$ErrorActionPreference='Stop'
+$sim='C:/intelFPGA_lite/17.0/modelsim_ase/win32aloem/vsim.exe'
+Push-Location $PSScriptRoot
+try {
+ $env:FAST='1'
+ foreach($caseMode in $Modes){
+  $env:MODE="$caseMode";$env:SHIFT="$(($caseMode*13)%72)"
+  & $sim -c -wlf "mode${caseMode}.wlf" -do run.do -l "mode${caseMode}.log" *> "mode${caseMode}_stdout.log"
+  $result=Get-Content "mode${caseMode}.log" -Raw
+  if($LASTEXITCODE -ne 0 -or $result -notmatch 'PASS fullstate' -or $result -match '\*\* (Fatal|Error|Failure):'){throw "FM mode $caseMode failed"}
+  if(@(Select-String 'PASS independent internal oracle' "mode${caseMode}.log").Count -ne 9){throw "incomplete oracle mode $caseMode"}
+  Write-Output "PASS fullstate mode=$caseMode"
+ }
+} finally {Remove-Item Env:FAST -ErrorAction SilentlyContinue;Pop-Location}
diff --git a/tests/ym2413_fullstate/map.do b/tests/ym2413_fullstate/map.do
new file mode 100644
index 00000000..1cffb3ac
--- /dev/null
+++ b/tests/ym2413_fullstate/map.do
@@ -0,0 +1,16 @@
+onerror {quit -code 1}
+vlog -sv -quiet -work test_work map_tb.sv
+vsim -t 1ps -L candidate_work test_work.map_tb
+set NumericStdNoWarnings 1
+set StdArithNoWarnings 1
+source oracle.tcl
+for {set pass 0} {$pass<8} {incr pass} {
+ run -all
+ if {[scalar /map_tb/pass]!=$pass} {error "unexpected pattern checkpoint"}
+ set expected {}
+ for {set i 0} {$i<104} {incr i} {lappend expected [scalar "/map_tb/patterns([expr {$pass*104+$i}])"]}
+ equal_words [state_words /map_tb/fm] $expected "independent injected pattern $pass"
+}
+onbreak {quit -code 1}
+run -all
+quit -code 0
