+++ b/tests/mapper_banking/run.py
@@ -0,0 +1,251 @@
+"""Audit extraction and run VHDL-93 directed/differential banking simulation.
+
+Usage: python run.py --modelsim C:/intelFPGA_lite/17.0/modelsim_ase/win32aloem
+Generated files and logs go to simulation/mapper_banking (ignored by Git).
+"""
+import argparse
+from pathlib import Path
+import re
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[2]
+BASE = '47a48e0382aed4923eef34616175bacc0c8dad52'
+OUT = ROOT / 'simulation/mapper_banking'
+
+
+def original(name):
+    return subprocess.check_output(['git', 'show', BASE + ':' + name], cwd=ROOT).decode('utf-8').replace('\r\n', '\n')
+
+
+def process(text):
+    start = text.index('\t-- external ram control\n')
+    end = text.index('\tend process;', start) + len('\tend process;')
+    return text[start:end]
+
+
+def simulation_cases(text):
+    # Quartus accepts four binary choices without others; ModelSim requires all
+    # nine-valued std_logic choices. Adapt BOTH simulation copies identically.
+    pattern = r'(case A\(1 downto 0\) is.*?)(\s*end case;)'
+    text, count = re.subn(pattern, r'\1\nwhen others => null;\2', text, flags=re.S)
+    assert count == 3
+    return text
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--modelsim', required=True, type=Path)
+    args = parser.parse_args()
+    OUT.mkdir(parents=True, exist_ok=True)
+    old = original('rtl/system.vhd')
+    new = (ROOT / 'rtl/system.vhd').read_text(encoding='utf-8')
+    ctrl = (ROOT / 'rtl/mapper_ctrl.vhd').read_text(encoding='utf-8')
+    assert process(old) == process(ctrl), 'Banking process changed'
+    assert original('rtl/mapper_detect.vhd') == (ROOT / 'rtl/mapper_detect.vhd').read_text(encoding='utf-8')
+    ports = re.findall(r'^\s*(\w+) : (in|out) (std_logic(?:_vector\(\d+ downto 0\))?)', ctrl, re.M)
+    inputs = [(n, t) for n, d, t in ports if d == 'in']
+    outputs = [(n, t) for n, d, t in ports if d == 'out']
+    owned = set(re.findall(r'\b(\w+)\s*(?:\([^;\n]*?\))?\s*<=', process(old)))
+    public = {n.removesuffix('_out') for n, t in outputs}
+    private = owned - public
+    instance = re.search(r'\tmapper_banking : entity work.mapper_ctrl\s+port map \((.*?)\n\t\t\);', new, re.S)
+    mappings = re.findall(r'(\w+) => (\w+)', instance[1])
+    assert len(mappings) == len(ports) == len(set(n for n, v in mappings))
+    assert dict(mappings) == {n: n.removesuffix('_out') if d == 'out' else n for n, d, t in ports}
+    for name in owned:
+        assert not re.search(r'\b' + name + r'\s*(?:\([^;\n]*?\))?\s*<=', new), name
+        assert len(re.findall(r'^\s*signal ' + name + r'\s*:', ctrl, re.M)) == 1
+    # Reconstruct only the permitted system edits and require whole-file equality.
+    expected = old.replace(process(old) + '\n', instance[0])
+    for name in private:
+        expected, count = re.subn(r'^\tsignal\s+' + name + r'\s*:[^\n]*\n', '', expected, flags=re.M)
+        assert count == 1
+    for name in public:
+        expected = re.sub(r'(^\tsignal\s+[\w, ]*\b' + name + r'\b[\w, ]*\s*:[^;\n]*?)\s*:=\s*[^;]+;', r'\1;', expected, flags=re.M)
+    expected = expected.replace('\tsignal mapper_codies_lock:\tstd_logic; \n', '\tsignal mapper_codies_lock:\tstd_logic;\n')
+    assert expected == new, 'Unrelated system logic changed'
+    for filename in ['files.qip', 'mist/sms_mist.qsf']:
+        before = original(filename)
+        line = next(x for x in before.splitlines(True) if 'mapper_detect.vhd' in x)
+        assert (ROOT / filename).read_text(encoding='utf-8') == before.replace(line, line + line.replace('mapper_detect', 'mapper_ctrl'))
+    # Independently retrieve every initial state from baseline declarations.
+    declarations = {}
+    for match in re.finditer(r'^\s*signal\s+([\w, ]+)\s*:\s*([^;]+);', old, re.M):
+        for name in match[1].replace(' ', '').split(','):
+            declarations[name] = match[2].strip()
+    for name in owned:
+        assert re.search(r'\bsignal ' + name + r'\s*:\s*' + re.escape(declarations[name]) + ';', ctrl)
+    header = ctrl[:ctrl.index('architecture rtl')].replace('mapper_ctrl', 'mapper_baseline')
+    reference = header + 'architecture reference of mapper_baseline is\n'
+    reference += ''.join(f'signal {n} : {declarations[n]};\n' for n in sorted(owned))
+    reference += 'begin\n' + ''.join(f'{n}_out <= {n};\n' for n in sorted(public))
+    reference += process(old) + '\nend architecture;\n'
+    (OUT / 'mapper_baseline.vhd').write_text(simulation_cases(reference), encoding='utf-8')
+    (OUT / 'mapper_ctrl_sim.vhd').write_text(simulation_cases(ctrl), encoding='utf-8')
+    tb = 'library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all;\nentity tb is end;\narchitecture test of tb is\n'
+    for name, typ in inputs:
+        default = "(others => '0')" if 'vector' in typ else "'0'"
+        tb += f'signal {name} : {typ} := {default};\n'
+    for name, typ in outputs:
+        tb += f'signal {name}, ref_{name} : {typ};\n'
+    tb += 'begin\n'
+    for entity, label, prefix in [('mapper_ctrl', 'dut', ''), ('mapper_baseline', 'baseline', 'ref_')]:
+        mapping = [f'{n} => {n}' for n, t in inputs] + [f'{n} => {prefix}{n}' for n, t in outputs]
+        tb += f'{label}: entity work.{entity} port map (' + ', '.join(mapping) + ');\n'
+    tb += 'stimulus: process\nvariable cycles : natural := 0;\nvariable rng : unsigned(31 downto 0) := x"12345678";\n'
+    tb += 'procedure tick is begin\nclk_sys <= \'0\'; wait for 5 ns; clk_sys <= \'1\'; wait for 5 ns;\n'
+    for name, typ in outputs:
+        tb += f'assert {name} = ref_{name} report "Differential mismatch: {name}" severity failure;\n'
+    tb += "cycles := cycles + 1; clk_sys <= '0'; end procedure;\n"
+    tb += 'procedure reset is begin\n'
+    for name, typ in inputs:
+        if name != 'clk_sys':
+            default = "(others => '0')" if 'vector' in typ else "'0'"
+            tb += f'{name} <= {default};\n'
+    tb += "WR_n <= '1'; MREQ_n <= '1'; ce_z80 <= '1'; tick; RESET_n <= '1'; bootloader_n <= '1'; tick; tick; end procedure;\n"
+    tb += '''procedure wr(addr, data : natural) is begin
+A <= std_logic_vector(to_unsigned(addr, 16)); D_in <= std_logic_vector(to_unsigned(data, 8));
+WR_n <= '0'; MREQ_n <= '0'; tick; WR_n <= '1'; MREQ_n <= '1'; tick; end procedure;
+procedure banks(b0,b1,b2,b3 : natural) is begin
+assert unsigned(bank0_out)=b0 and unsigned(bank1_out)=b1 and unsigned(bank2_out)=b2 and unsigned(bank3_out)=b3
+report "Unexpected bank state at cycle " & integer'image(cycles) severity failure; end procedure;
+begin
+reset; banks(0,1,2,3);
+wr(16#FFFD#, 9); wr(16#FFFE#, 10); wr(16#FFFF#, 11); banks(9,10,11,3);
+wr(16#FFFC#, 28);
+assert nvram_e_out='1' and nvram_ex_out='1' and nvram_p_out='1' severity failure;
+ss_freeze <= '1'; wr(16#FFFD#, 99); banks(9,10,11,3);
+mapper_in <= x"1E7C554433221100"; mapper_set <= '1'; tick;
+banks(0,17,34,51);
+assert pak4_reg2_out=x"44" and nem_bank0_out=x"55" and nvram_p_out='1' and nvram_e_out='1'
+and nvram_ex_out='1' and nvram_cme_out='1' and mapper_4pak_out='1' and mapper_codies_out='1'
+and lock_mapper_B_out='1' and mapper_codies_lock_out='1' severity failure;
+mapper_set <= '0'; tick; banks(0,17,34,51);
+report "PASS Sega, NVRAM, freeze, standard restore";
+
+reset; mapper_codies_force <= '1'; bootloader_n <= '0'; tick; bootloader_n <= '1'; tick;
+banks(0,1,0,3); assert mapper_codies_out='1' and mapper_codies_lock_out='1' severity failure;
+wr(0,7); wr(16#4000#,16#85#); wr(16#8000#,9); banks(7,5,9,3);
+assert nvram_cme_out='1' severity failure;
+wr(16#FFFF#,22); banks(7,5,9,3);
+reset; detect_codies_static <= '1'; bootloader_n <= '0'; tick; bootloader_n <= '1'; tick;
+assert mapper_codies_out='1' severity failure; wr(16#8000#,13); banks(0,1,13,3);
+report "PASS forced/static Codemasters";
+
+reset; mapper_wonderkid <= '1'; tick; banks(0,0,0,3);
+assert lock_mapper_B_out='1' severity failure;
+wr(0,17); wr(16#4000#,18); banks(0,0,0,3);
+wr(16#8000#,19); banks(0,0,19,3);
+ss_freeze <= '1'; wr(16#8000#,20); banks(0,0,19,3);
+ss_freeze <= '0'; mapper_lock <= '1'; wr(16#8000#,20); banks(0,0,19,3);
+mapper_lock <= '0'; wr(16#FFFC#,8); wr(16#8000#,20); banks(0,0,19,3);
+mapper_eeprom <= '1'; wr(16#8000#,21); banks(0,0,19,3);
+wr(16#FFFF#,22); banks(0,0,22,3);
+report "PASS Wonder Kid $8000 and gating";
+
+reset; use_zem <= '1'; wr(0,12); wr(1,13); wr(2,14); wr(3,15); banks(14,15,12,13);
+wr(16#FFFF#,99); banks(14,15,12,13);
+RESET_n <= '0'; mapper_nemesis_auto <= '1'; rom_size_pages <= x"20"; tick; RESET_n <= '1'; tick;
+assert nem_bank0_out=x"1F" severity failure;
+RESET_n <= '0'; mapper_zemina_force <= '1'; tick; RESET_n <= '1'; tick;
+assert nem_bank0_out=x"00" severity failure;
+RESET_n <= '0'; mapper_zemina_force <= '0'; rom_size_pages <= x"00"; tick; RESET_n <= '1'; tick;
+assert nem_bank0_out=x"00" severity failure;
+report "PASS Zemina and Nemesis defaults";
+
+reset; wr(16#3FFE#,16#20#); banks(32,1,32,3); assert mapper_4pak_out='1' severity failure;
+wr(16#BFFF#,5); banks(32,1,37,3); assert pak4_reg2_out=x"05" severity failure;
+wr(16#3FFE#,16#10#); wr(16#7FFF#,7); banks(16,7,21,3);
+wr(16#BFFF#,255); banks(16,7,15,3);
+reset; mapper_manual_force <= '1'; wr(16#3FFE#,32); banks(0,1,2,3);
+assert mapper_4pak_out='0' severity failure;
+reset; sega_mapper_write_seen <= '1'; wr(16#3FFE#,32); assert mapper_4pak_out='0' severity failure;
+report "PASS 4-PAK writes and trigger exclusion";
+
+reset; mapper_janggun <= '1'; wr(16#4000#,16#89#); wr(16#6000#,10); wr(16#8000#,16#8B#); wr(16#A000#,12);
+assert jang_bank1_out="001001" and jang_bank2_out="001010" and jang_bank3_out="001011" and jang_bank4_out="001100"
+and jang_rev1_out='1' and jang_rev2_out='0' and jang_rev3_out='1' and jang_rev4_out='0' severity failure;
+wr(16#FFFE#,16#43#); wr(16#FFFF#,16#85#);
+assert unsigned(jang_bank1_out)=6 and unsigned(jang_bank2_out)=7 and unsigned(jang_bank3_out)=10 and unsigned(jang_bank4_out)=11
+and jang_rev1_out='1' and jang_rev2_out='1' and jang_rev3_out='1' and jang_rev4_out='1' severity failure;
+mapper_in <= x"000000008C0B8A09"; mapper_set <= '1'; ss_freeze <= '1'; tick;
+assert unsigned(jang_bank1_out)=9 and unsigned(jang_bank2_out)=10 and unsigned(jang_bank3_out)=11 and unsigned(jang_bank4_out)=12
+and jang_rev1_out='0' and jang_rev2_out='1' and jang_rev3_out='0' and jang_rev4_out='1' severity failure;
+report "PASS Janggun banks, reversal, paired writes and restore";
+'''
+    for inhibit in ['mapper_castle', 'mapper_dahjee_a', 'mapper_linear', 'mapper_sega_locked', 'systeme', 'sc3000_en']:
+        tb += f"reset; {inhibit} <= '1'; wr(16#FFFD#,9); wr(16#8000#,8); wr(16#3FFE#,32); banks(0,1,2,3);\n"
+        tb += f'assert mapper_4pak_out=\'0\' severity failure; report "PASS {inhibit} inhibits banking";\n'
+    tb += '''reset; wr(16#FFFD#,9); bootloader_n <= '0'; tick; wr(16#FFFE#,10); banks(9,10,2,3);
+bootloader_n <= '1'; ss_freeze <= '1'; tick; banks(0,1,2,3);
+bootloader_n <= '0'; tick; mapper_in <= x"0000000033221109"; mapper_set <= '1'; bootloader_n <= '1'; tick;
+banks(9,17,34,51); mapper_set <= '0'; tick; banks(9,17,34,51);
+reset; use_zem <= '1'; bootloader_n <= '0'; tick; wr(16#FFFD#,7); banks(7,1,2,3);
+bootloader_n <= '1'; tick; banks(0,1,2,3);
+report "PASS BIOS handoff, frozen handoff, restore edge suppression and BIOS Sega writes";
+
+reset; mapper_eeprom <= '1'; mapper_castle <= '1'; use_zem <= '1'; mapper_codies_force <= '1';
+wr(16#3FFE#,32); wr(16#8000#,20); banks(0,1,2,3); assert mapper_4pak_out='0' severity failure;
+wr(16#FFFD#,7); wr(16#FFFE#,8); wr(16#FFFF#,9); banks(7,8,9,3);
+A <= x"FFFC"; D_in <= x"9C"; WR_n <= '0'; MREQ_n <= '0'; tick;
+assert eeprom_soft_reset_out='1' and nvram_e_out='0' and nvram_ex_out='0' and nvram_p_out='0' severity failure;
+WR_n <= '1'; tick; assert eeprom_soft_reset_out='0' severity failure;
+WR_n <= '0'; ss_freeze <= '1'; tick; assert eeprom_soft_reset_out='0' severity failure;
+ss_freeze <= '0'; mapper_janggun <= '1'; tick; assert eeprom_soft_reset_out='0' severity failure;
+report "PASS EEPROM priority, pulse and Janggun precedence";
+
+reset; mapper_evolution <= '1'; evolution_ss_in(31 downto 16) <= x"E132";
+mapper_in <= x"0000090807060000"; mapper_set <= '1'; tick; banks(9,8,7,6);
+assert nvram_e_out='0' and mapper_4pak_out='0' and mapper_codies_out='0' severity failure;
+mapper_set <= '0'; evolution_game_launch <= '1'; ss_freeze <= '1'; tick; banks(0,1,2,3);
+ss_freeze <= '0'; A <= x"FFFF"; D_in <= x"19"; WR_n <= '0'; MREQ_n <= '0'; tick; banks(0,1,25,3);
+reset; wr(16#FFFD#,9); systeme <= '1'; mapper_in <= x"0000000033221108"; mapper_set <= '1'; tick; banks(9,17,34,51);
+report "PASS Evolution restore/launch priorities and System E restore layout";
+
+reset; A <= x"A000"; WR_n <= '1'; MREQ_n <= '0'; tick;
+wr(16#A000#,9); banks(0,1,2,3);
+A <= x"9000"; MREQ_n <= '0'; tick; wr(16#A000#,9); banks(0,1,9,3);
+report "PASS Korean anti-LDIR banking";
+
+reset;
+for i in 0 to 19999 loop
+rng := rng(30 downto 0) & (rng(31) xor rng(21) xor rng(1) xor rng(0));
+D_in <= std_logic_vector(rng(15 downto 8));
+case to_integer(rng(3 downto 0)) is
+when 0 => A <= x"FFFC"; when 1 => A <= x"FFFD"; when 2 => A <= x"FFFE"; when 3 => A <= x"FFFF";
+when 4 => A <= x"0000"; when 5 => A <= x"0001"; when 6 => A <= x"0002"; when 7 => A <= x"0003";
+when 8 => A <= x"3FFE"; when 9 => A <= x"7FFF"; when 10 => A <= x"BFFF";
+when 11 => A <= x"4000"; when 12 => A <= x"6000"; when 13 => A <= x"8000"; when 14 => A <= x"A000";
+when others => A <= std_logic_vector(rng(31 downto 16)); end case;
+WR_n <= rng(4); MREQ_n <= rng(5); ss_freeze <= rng(6); ce_z80 <= rng(7);
+mapper_in <= std_logic_vector(rng & (not rng)); rom_size_pages <= std_logic_vector(rng(15 downto 8));
+if i mod 37 = 0 then RESET_n <= '0'; else RESET_n <= '1'; end if;
+if i mod 19 = 0 then mapper_set <= '1'; else mapper_set <= '0'; end if;
+if i mod 23 = 0 then evolution_game_launch <= '1'; else evolution_game_launch <= '0'; end if;
+if i mod 3 = 0 then evolution_ss_in(31 downto 16) <= x"E132"; else evolution_ss_in(31 downto 16) <= x"0000"; end if;
+'''
+    flags = [n for n, t in inputs if t == 'std_logic' and n not in ['RESET_n', 'clk_sys', 'WR_n', 'MREQ_n', 'ss_freeze', 'ce_z80', 'mapper_set', 'evolution_game_launch']]
+    for bit, name in enumerate(flags):
+        tb += f'{name} <= rng({bit + 8});\n'
+    tb += 'tick;\nend loop;\nreport "PASS all directed tests and 20000 differential cycles"; wait; end process; end;\n'
+    (OUT / 'tb.vhd').write_text(tb, encoding='utf-8')
+    print(f'AUDIT PASS: verbatim process, {len(owned)} state owners, {len(ports)} unique mappings, initializers, detector, save packing, unrelated logic and source lists', flush=True)
+    commands = [
+        ['vlib', 'work'],
+        ['vcom', '-93', 'mapper_ctrl_sim.vhd', 'mapper_baseline.vhd', 'tb.vhd'],
+        ['vsim', '-c', '-onfinish', 'stop', 'work.tb', '-do', 'onerror {quit -code 1}; onbreak {quit -code 1}; run 250 us; quit -code 0'],
+    ]
+    with (OUT / 'simulation.log').open('w', encoding='utf-8') as log:
+        for command in commands:
+            command[0] = str(args.modelsim / (command[0] + '.exe'))
+            result = subprocess.run(command, cwd=OUT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+            log.write(result.stdout)
+            print(result.stdout, flush=True)
+            if result.returncode:
+                raise SystemExit(result.returncode)
+        if 'PASS all directed tests and 20000 differential cycles' not in result.stdout:
+            raise SystemExit('Simulation did not complete')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tests/mapper_banking/README.md b/tests/mapper_banking/README.md
new file mode 100644
--- /dev/null
+++ b/tests/mapper_banking/README.md
@@ -0,0 +1,42 @@
+Run from any directory with Python 3.9+ and ModelSim:
+
+```powershell
+python tests/mapper_banking/run.py --modelsim C:/intelFPGA_lite/17.0/modelsim_ase/win32aloem
+```
+
+The script compares the extraction with merged PR #1 commit
+`47a48e0382aed4923eef34616175bacc0c8dad52`. It checks the complete banking process,
+all initial values, state ownership, every port association, project source lists,
+and the rest of `system.vhd`. It also checks that `mapper_detect.vhd` is unchanged.
+Thus the final save-state packing, address decoding, and bus mux must remain
+unchanged for the audit to pass.
+
+Simulation uses VHDL-93. Directed assertions cover Sega, forced/static
+Codemasters, Wonder Kid and its write exclusions, Zemina/Nemesis, 4-PAK,
+Janggun/reversal, Castle, Dahjee A, linear, Sega-locked, System E and SC-3000
+bank-write inhibition, reset, freeze, restore, BIOS handoff, EEPROM priority and
+soft reset, Evolution bank restore/launch, and Korean anti-LDIR behavior.
+Every directed clock and 20,000 deterministic randomized clocks compare all
+23 exported state signals against a separately generated baseline process.
+Randomized inputs include conflicting selections to exercise branch priority.
+
+The baseline RTL has three two-bit `std_logic_vector` case statements with only
+binary choices. Quartus accepts these, but ModelSim requires coverage of the
+remaining nine-valued logic combinations. The script adds `when others => null`
+to **both generated simulation copies only**. Repository RTL is untouched, and
+stimulus uses binary addresses. This does not verify behavior for nonbinary
+addresses. The run is a banking-process simulation, not a full-core or hardware
+regression.
+
+Generated VHDL, the simulator work library, and `simulation.log` are written to
+`simulation/mapper_banking/`, which is already ignored by the repository.
+Any assertion failure or missing completion marker fails the command.
+
+For full-core validation, create clean baseline/refactored source snapshots,
+including identical supporting sources and suppression settings, then run
+`quartus_sh --flow compile SMS` in each. Compare `SMS.map.summary`,
+`SMS.fit.summary`, `SMS.sta.rpt`, and warning messages in both `.rpt` and `.smsg`
+files. Normalize snapshot paths, moved source-line numbers, and the added
+`mapper_ctrl:mapper_banking|` hierarchy when comparing messages. Do not interpret
+fitter/timing variation as a performance improvement. Hardware regression is a
+separate review step.
